# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit API keys.
# These keys are used ONLY by scripts/snapshot.mjs (Node, build time).
# They are never bundled into the browser app.

# Yelp Fusion — https://www.yelp.com/developers  (single API key)
YELP_API_KEY=

# Google Places API (New) — enable "Places API (New)" in Google Cloud Console
GOOGLE_PLACES_API_KEY=

# Ticketmaster Discovery API — https://developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Amadeus Self-Service — https://developers.amadeus.com  (client id + secret)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Use test.api.amadeus.com (default) for test keys, api.amadeus.com for production
AMADEUS_HOSTNAME=test.api.amadeus.com
